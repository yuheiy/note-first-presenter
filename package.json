{
  "name": "note-first-presenter-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run messages && vp run --filter client --filter demo --filter note-first-presenter --parallel dev",
    "test": "vp run test:unit && vp run test:integration && vp run test:e2e",
    "test:unit": "vp run messages && vp run --filter './packages/*' test",
    "messages": "vp run client#compile-messages",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "knip": "catalog:",
    "note-first-presenter": "workspace:*",
    "playwright": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.15.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
