{
  "$schema": "./node_modules/knip/schema.json",
  "rules": {
    "catalog": "off"
  },
  "workspaces": {
    ".": {
      "entry": ["test/**/*.test.ts"],
      "ignoreDependencies": ["vite"]
    },
    "packages/note-first-presenter": {
      "entry": ["src/cli.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/client": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "demo": {
      "entry": []
    },
    "e2e/fixtures/*": {
      "entry": [],
      "ignoreDependencies": ["note-first-presenter"]
    }
  }
}
