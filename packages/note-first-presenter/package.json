{
  "name": "note-first-presenter",
  "version": "0.0.0",
  "description": "A presentation tool where you write notes first in an outliner, then pair them with slide images rendered from a PDF.",
  "homepage": "https://github.com/yuheiy/note-first-presenter#readme",
  "bugs": {
    "url": "https://github.com/yuheiy/note-first-presenter/issues"
  },
  "license": "MIT",
  "author": "Yuhei Yasuda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuheiy/note-first-presenter.git",
    "directory": "packages/note-first-presenter"
  },
  "bin": {
    "note-first-presenter": "./bin/note-first-presenter.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepack": "vp run build",
    "prepublishOnly": "vp run -w verify:package"
  },
  "dependencies": {
    "@napi-rs/canvas": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "chokidar": "catalog:",
    "citty": "catalog:",
    "eta": "catalog:",
    "pdfjs-dist": "catalog:",
    "valibot": "catalog:",
    "vite": "^8.0.0",
    "vitefu": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  },
  "peerDependencies": {
    "@note-first-presenter/client": "workspace:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
