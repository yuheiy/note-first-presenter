{
  // Written by hand since R1: this used to extend ./.svelte-kit/tsconfig.json,
  // which SvelteKit generated. Type checking runs through `vp check` (tsgolint)
  // only — there is no `tsc --noEmit` script. See docs/adr/0014, and docs/adr/0007's
  // 2026-07-26 addendum for why svelte-check went first.
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    // vite/client supplies import.meta.env and import.meta.hot; @types/node is
    // needed by vite.config.ts.
    "types": ["vite/client", "node"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
