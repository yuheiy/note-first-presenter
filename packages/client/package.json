{
  "name": "@note-first-presenter/client",
  "version": "0.0.0",
  "description": "UI client for note-first-presenter.",
  "homepage": "https://github.com/yuheiy/note-first-presenter#readme",
  "bugs": {
    "url": "https://github.com/yuheiy/note-first-presenter/issues"
  },
  "license": "MIT",
  "author": "Yuhei Yasuda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuheiy/note-first-presenter.git",
    "directory": "packages/client"
  },
  "files": [
    "index.html",
    "src",
    "!src/**/__tests__",
    "tsconfig.json"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./dbSchema": "./src/lib/dbSchema.ts"
  },
  "scripts": {
    "test": "vp test",
    "dev": "vp run compile-messages --watch",
    "compile-messages": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy preferredLanguage baseLocale --emit-ts-declarations --no-emit-git-ignore --no-emit-prettier-ignore --no-emit-readme",
    "prepare": "vp run compile-messages"
  },
  "dependencies": {
    "@phosphor-icons/react": "catalog:",
    "clsx": "catalog:",
    "ofetch": "catalog:",
    "prosemirror-commands": "catalog:",
    "prosemirror-history": "catalog:",
    "prosemirror-keymap": "catalog:",
    "prosemirror-model": "catalog:",
    "prosemirror-schema-list": "catalog:",
    "prosemirror-state": "catalog:",
    "prosemirror-transform": "catalog:",
    "prosemirror-view": "catalog:",
    "react": "catalog:",
    "react-aria-components": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:"
  }
}
